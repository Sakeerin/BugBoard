# Database — the app connects as the least-privilege user (rights only on this
# schema), never as root. Matches the docker-compose MYSQL_USER/PASSWORD below.
DATABASE_URL="mysql://bugboard:bugboard@localhost:3306/bugboard"

# docker-compose MySQL credentials. Dev defaults shown; override for anything
# shared/production. root stays admin-only and is never used by the app.
MYSQL_ROOT_PASSWORD="bugboard"
MYSQL_DATABASE="bugboard"
MYSQL_USER="bugboard"
MYSQL_PASSWORD="bugboard"

# Auth.js — REQUIRED. Generate a strong value: openssl rand -base64 32
# Never ship a placeholder to production: the server refuses to start with a
# weak/empty secret when NODE_ENV=production (a weak secret lets JWTs be forged).
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# (Optional) GitHub OAuth
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# (Optional) Redis for scaled real-time
# REDIS_URL="redis://localhost:6379"
